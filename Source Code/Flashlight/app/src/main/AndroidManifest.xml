<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Android Studio Flashlight
    
    Developed by: Amey Thakur & Mega Satish
    GitHub: https://github.com/Amey-Thakur | https://github.com/msatmod
    Repository: https://github.com/Amey-Thakur/ANDROID-STUDIO-FLASHLIGHT
    
    Description: System-level application configuration for the Android Flashlight.
    Defines hardware permissions (Camera, Flashlight) and activity routing.
    
    Release Date: May 27, 2022
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="android.nachiketa.flashlight">

    <!-- Hardware Permissions: Required for LED control and hardware interaction -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>